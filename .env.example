# ============================================================================
# Antigravity WoW Forever Bridge — Optional .env Configuration Template
# Copy this file to `.env` (`cp .env.example .env`) or run:
#   python3 bridge/daemon.py --setup-auth
# ============================================================================

# [Option 1] Google AI Studio API Key (for `--backend sdk` Cloud Gemini)
# Issue key at: https://aistudio.google.com/app/api-keys
# GEMINI_API_KEY=your_api_key_here

# [Option 2] Gemini Enterprise / Vertex AI (Standard ADC Mode)
# Run `gcloud auth application-default login` first, then uncomment:
# AGY_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# [Option 3] Optional default WoW Forever installation directory
# WOW_FOREVER_DIR=/Applications/World of Warcraft/_forever_
